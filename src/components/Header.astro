---
interface Props {
	activePage: string;
}

const { activePage } = Astro.props;

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Matches', href: '/matches' },
	{ label: 'Events', href: '/events' },
	{ label: 'Stats', href: '/stats' },
];
---

<header class="sticky top-0 z-50 h-16 w-full bg-gray-300 text-[larger] text-white dark:bg-[#1e1e1e]">
	<div class="mx-auto flex h-full max-w-315 items-stretch justify-between">
		<!-- left group: logo + title + nav links -->
		<div class="hidden items-stretch md:flex">
			<a href="/" class="flex items-center gap-6 border-l border-neutral-200 pr-4 pl-4 dark:border-[#333]">
				<img src="/icons/PCMT Logo.png" alt="PCMT Logo" class="hidden h-auto w-12 dark:block" />
				<img src="/icons/PCMT Logo Light.png" alt="PCMT Logo" class="block h-auto w-12 dark:hidden" />
				<span class="hidden text-black lg:block dark:text-white">Plat Chat Members Tournament</span>
				<span class="block text-black lg:hidden dark:text-white">PCMT</span>
			</a>

			<nav class="flex items-stretch border-r border-neutral-200 dark:border-[#333]">
				{
					links.map((link) => (
						<a
							href={link.href}
							class={
								(link.label === activePage
									? 'text-black dark:text-white '
									: 'text-neutral-600 hover:text-neutral-500 dark:text-[#aaa] dark:hover:text-white ') +
								'flex items-center border-l border-neutral-200 px-6 text-[15px] transition-colors dark:border-[#333]'
							}
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>

		<div class="flex flex-col md:hidden">
			<button
				onclick="toggleNav()"
				class="my-auto ml-2 inline-flex items-center justify-center rounded-md p-2 text-neutral-400 hover:bg-neutral-400 hover:text-white focus:ring-2 focus:ring-white focus:outline-none focus:ring-inset dark:hover:bg-neutral-700"
				aria-expanded="false"
			>
				<svg
					id="nav-menu-closed"
					class="block h-6 w-6"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
					></path>
				</svg>
				<svg
					id="nav-menu-open"
					class="hidden h-6 w-6"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
					></path>
				</svg>
			</button>

			<div id="mobile-menu" class="hidden md:hidden">
				<div class="absolute z-40 flex w-full flex-col space-y-1 bg-neutral-300 dark:bg-neutral-800">
					{
						links.map((link) => (
							<a
								href={link.href}
								class={
									(link.label === activePage
										? 'text-black dark:text-white '
										: 'text-neutral-600 hover:text-neutral-500 dark:text-[#aaa] dark:hover:text-white ') +
									'mb-0 flex items-center border-neutral-200 px-6 py-3 text-[15px] transition-colors not-last:border-b dark:border-[#333]'
								}
							>
								{link.label}
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div class="mr-auto ml-2 flex md:hidden">
			<a href="/" class="flex items-center gap-4 dark:border-[#333]">
				<img src="/icons/PCMT Logo.png" alt="PCMT Logo" class="hidden h-12 w-auto dark:block" />
				<img src="/icons/PCMT Logo Light.png" alt="PCMT Logo" class="block h-12 w-auto dark:hidden" />
				<span class="hidden text-black md:block dark:text-white">Plat Chat Members Tournament</span>
				<span class="block text-black md:hidden dark:text-white">PCMT</span>
			</a>
		</div>

		<!-- right group: night-mode toggle -->
		<div class="flex items-stretch">
			<button
				id="funToggle"
				type="button"
				class="flex flex-none cursor-pointer items-center gap-1 border-l border-neutral-200 px-4 text-[11px] text-neutral-800 transition-colors hover:text-neutral-500 dark:border-[#333] dark:text-[#aaa] dark:hover:text-white"
			>
				<img src="/res/night.png" id="night-pfp" class="fun:inline hidden h-4 w-4" />
				<img src="/res/night-bw.png" id="night-pfp" class="fun:hidden inline h-4 w-4" />
				<span class="flex flex-col items-start leading-tight">
					<span>Night:</span>
					<span id="funState" class="font-semibold text-red-500">off</span>
				</span>
			</button>
			<button
				id="themeToggle"
				type="button"
				class="flex flex-none cursor-pointer items-center gap-1 border-r border-l border-neutral-200 px-4 text-[11px] text-neutral-800 transition-colors hover:text-neutral-500 dark:border-[#333] dark:text-[#aaa] dark:hover:text-white"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					class="fill-neutral-800 hover:fill-neutral-500 dark:fill-[#aaa] dark:hover:fill-white"
				>
					<path d="M0 0h24v24H0z" fill="none"></path>
					<path d="M12 3h.393a7.5 7.5 0 0 0 7.92 12.446A9 9 0 1 1 12 2.992z"></path>
				</svg>
				<span class="flex flex-col items-start leading-tight">
					<span>Night:</span>
					<span id="nightState" class="font-semibold text-red-500">off</span>
				</span>
			</button>
		</div>
	</div>
</header>
<script is:inline>
	let mobileNavExpanded = false;

	function toggleNav() {
		let classes = document.getElementById('mobile-menu')?.classList;
		let closeIcon = document.getElementById('nav-menu-closed')?.classList;
		let openIcon = document.getElementById('nav-menu-open')?.classList;

		if (!classes || !closeIcon || !openIcon) {
			return;
		}

		if (!mobileNavExpanded) {
			classes.remove('hidden');
			classes.remove('sm:hidden');
			classes.add('block');
			classes.add('sm:block');

			openIcon.remove('hidden');
			openIcon.add('block');

			closeIcon.remove('block');
			closeIcon.add('hidden');
		} else {
			classes.add('hidden');
			classes.add('sm:hidden');
			classes.remove('block');
			classes.remove('sm:block');

			openIcon.remove('block');
			openIcon.add('hidden');

			closeIcon.remove('hidden');
			closeIcon.add('block');
		}
		mobileNavExpanded = !mobileNavExpanded;
	}

	// dark theme, shamelessly stolen from astro docs
	const theme = (() => {
		const localStorageTheme = localStorage?.getItem('theme') ?? '';

		if (['dark', 'light'].includes(localStorageTheme)) {
			return localStorageTheme;
		}
		if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
			return 'dark';
		}
		return 'light';
	})();

	const fun = (() => {
		const localStorageFun = localStorage?.getItem('fun') ?? '';
		if (['yes', 'no'].includes(localStorageFun)) {
			return localStorageFun;
		}
		return 'yes';
	})();

	if (theme === 'light') {
		document.body.classList.remove('dark');
	} else {
		document.body.classList.add('dark');
	}

	window.localStorage.setItem('theme', theme);

	if (fun === 'yes') {
		document.body.classList.add('fun');
	} else {
		document.body.classList.remove('fun');
	}

	window.localStorage.setItem('fun', fun);

	const updateNightLabel = () => {
		const state = document.getElementById('nightState');
		if (!state) return;
		const isDark = document.body.classList.contains('dark');
		state.textContent = isDark ? 'on' : 'off';
		state.classList.toggle('text-green-500', isDark);
		state.classList.toggle('text-red-500', !isDark);
	};

	const updateFunLabel = () => {
		const state = document.getElementById('funState');
		if (!state) return;
		const isFun = document.body.classList.contains('fun');
		state.textContent = isFun ? 'on' : 'off';
		state.classList.toggle('text-green-500', isFun);
		state.classList.toggle('text-red-500', !isFun);
	};

	const handleToggleClick = () => {
		const element = document.body;
		element.classList.toggle('dark');

		const isDark = element.classList.contains('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');

		if (isDark) {
			let smoke = new Audio('/res/smoke.mp3');
			smoke.play();
		} else {
			let flashbang = new Audio('/res/flashbang.mp3');
			flashbang.play();
		}

		updateNightLabel();
	};
	const handleFunClick = () => {
		const element = document.body;
		element.classList.toggle('fun');

		const isFun = element.classList.contains('fun');
		localStorage.setItem('fun', isFun ? 'yes' : 'no');

		updateFunLabel();
	};

	document.getElementById('themeToggle')?.addEventListener('click', handleToggleClick);
	document.getElementById('funToggle')?.addEventListener('click', handleFunClick);
	updateNightLabel();
	updateFunLabel();
</script>
