---
import EventHeader from './EventHeader.astro';
import EventPanels from './EventPanels.tsx';
import type { Event } from '../../types/types.ts';

interface Props {
	event: Event;
}

const { event } = Astro.props;
---

<div class="h-full font-[roboto]">
	<EventHeader event={event} />

	<EventPanels event={event} client:load />
</div>
