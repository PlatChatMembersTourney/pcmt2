---
import { eventLogo, regionFlag } from '../../utils/images.ts';
import type { Event } from '../../types/types.ts';
interface Props {
	event: Event;
}

const { name, desc, region, dates, prize, showmatch } = Astro.props.event;
---

<div class="bg-shade-100 flex gap-4 p-4 sm:gap-6 sm:p-6">
	<div class="flex h-30 w-30 flex-none items-center justify-center rounded-sm border border-neutral-500">
		<img src={eventLogo(showmatch, region)} class="h-28 w-28 rounded-sm" />
	</div>

	<div class="flex flex-col">
		<a href="/events" class="text-pb text-[10pt] leading-4">Plat Chat Members Tournament</a>
		<h1 class="mb-1 text-xl font-black text-main sm:text-2xl">PCMT: {name}</h1>
		<p class="mb-2 flex-grow text-xs text-main">{desc}</p>
		<dl class="flex flex-row gap-6">
			<div class="flex flex-col gap-1.5">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Dates</dt>
				<dd class="dark:text-vlr-text-white text-xs leading-tight">{dates}</dd>
			</div>
			<div class="hidden flex-col gap-1.5 sm:flex">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Prize</dt>
				<dd class="dark:text-vlr-text-white text-xs leading-tight">{prize}</dd>
			</div>
			<div class="flex flex-col gap-1.5">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Region</dt>
				<dd class="h-4">
					<img src={regionFlag(region)} />
				</dd>
			</div>
		</dl>
	</div>
</div>
