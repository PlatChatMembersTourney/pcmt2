---
import { regionFlag } from '../../utils/images.ts';
interface Props {
	name: string;
	desc: string;
	region: string;
	dates: string;
	prize: string;
	showmatch?: boolean;
}

const { name, desc, region, dates, prize, showmatch } = Astro.props;
---

<div class="bg-vlr-gray-100 dark:bg-vlr-gray-600 flex gap-4 p-4 sm:gap-6 sm:p-6">
	<div class="flex h-30 w-30 flex-none items-center justify-center rounded-sm border border-neutral-500">
		<img
			src={showmatch
				? '/icons/PC%20Logo%20Box.png'
				: region === 'na'
					? '/icons/NA%20Logo.png'
					: '/icons/EMEA%20Logo.png'}
			class="h-28 w-28 rounded-sm"
		/>
	</div>

	<div class="flex flex-col">
		<a href="/events" class="text-pb text-[10pt] leading-4">Plat Chat Members Tournament</a>
		<h1 class="dark:text-vlr-text-white mb-1 text-xl font-black text-black sm:text-2xl">PCMT: {name}</h1>
		<p class="dark:text-vlr-text-white mb-2 flex-grow text-xs text-black">{desc}</p>
		<dl class="flex flex-row gap-6">
			<div class="flex flex-col gap-1.5">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Dates</dt>
				<dd class="dark:text-vlr-text-white text-xs leading-tight">{dates}</dd>
			</div>
			<div class="hidden flex-col gap-1.5 sm:flex">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Prize</dt>
				<dd class="dark:text-vlr-text-white text-xs leading-tight">{prize}</dd>
			</div>
			<div class="flex flex-col gap-1.5">
				<dt class="dark:text-vlr-text-light text-[10px] leading-none uppercase">Region</dt>
				<dd class="h-4">
					<img src={regionFlag(region)} />
				</dd>
			</div>
		</dl>
	</div>
</div>
