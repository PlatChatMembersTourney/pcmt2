---
import Layout from '../../../layouts/Layout.astro';
import seasons from '../../../data/events.json';
import { fromJson } from '../../../utils/json.ts';
import EventPage from '../../../components/events/EventPage.astro';
import type { Event, Match, TeamInfo } from '../../../types/types.ts';
import slugify from 'slugify';

interface Props {
	event: Event;
	matchName: string;
	match: Match;
	teams: Record<string, TeamInfo>;
	stage: string;
}

import { matches, teams as allTeams } from '../../../stores/store.ts';
import MatchPage from '../../../components/matches/MatchPage';

export const getStaticPaths = () => {
	return Object.entries(matches).flatMap(([id, matches]) => {
		return matches.map((match) => {
			return {
				params: {
					id: id,
					match: slugify(match.id),
				},
				props: {
					event: fromJson<Event[]>(seasons).filter((event) => {
						return event.id === id;
					})[0],
					matchName: match.team1Name + ' vs ' + match.team2Name,
					match,
					teams: allTeams[id],
					stage: match.stage,
				},
			};
		});
	});
};

const { event, matchName, match, teams, stage } = Astro.props;
---

<Layout
	activePage="Events"
	desc={'an intense life or death duel: ' + matchName + ' in the ' + stage}
	title={matchName + ' | PCMT'}
	bodyClass="bg-vlr-gray-400 dark:bg-vlr-gray-900 font-sans m-0 min-h-screen grid w-full grid-rows-[auto_1fr_auto]"
	mainClass="mx-auto w-full max-w-315 root dark:bg-vlr-gray-800 min-w-0"
>
	<div class="h-full">
		<MatchPage event={event} match={match} teams={teams} client:load />
	</div>
</Layout>
