---
import Layout from '../../../layouts/Layout.astro';
import { events } from '../../../stores/events.ts';

import type { Event, Match, TeamInfo } from '../../../types/types.ts';
import slugify from 'slugify';

interface Props {
	event: Event;
	matchName: string;
	match: Match;
	teams: Record<string, TeamInfo>;
	stage: string;
}

import { matches } from '../../../stores/matches.ts';
import { teams as allTeams } from '../../../stores/teams.ts';
import MatchPage from '../../../components/matches/MatchPage';

export const getStaticPaths = () => {
	return Object.entries(matches).flatMap(([id, matches]) => {
		return matches.map((match) => {
			return {
				params: {
					id: id,
					match: slugify(match.id),
				},
				props: {
					event: events.find((event) => event.id === id)!,
					matchName: match.team1Name + ' vs ' + match.team2Name,
					match,
					teams: allTeams[id],
					stage: match.stage,
				},
			};
		});
	});
};

const { event, matchName, match, teams, stage } = Astro.props;
---

<Layout
	activePage="Events"
	desc={'an intense life or death duel: ' + matchName + ' in the ' + stage}
	title={matchName + ' | PCMT'}
	bodyClass="bg-shade-400 font-sans m-0 min-h-screen grid w-full grid-rows-[auto_1fr_auto]"
	mainClass="mx-auto w-full max-w-315 root dark:bg-vlr-gray-800 min-w-0"
>
	<div class="h-full">
		<MatchPage event={event} match={match} teams={teams} client:load />
	</div>
</Layout>
