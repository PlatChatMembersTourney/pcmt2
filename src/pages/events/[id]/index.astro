---
import Layout from '../../../layouts/Layout.astro';
import { events } from '../../../stores/events.ts';

import EventPage from '../../../components/events/EventPage.astro';
import type { Event } from '../../../types/types.ts';

type Props = Event;

export const getStaticPaths = () => {
	return events.map((entry) => {
		return {
			params: {
				id: entry.id,
			},
			props: entry,
		};
	});
};

const { desc, name } = Astro.props;
---

<Layout
	activePage="Events"
	desc={desc}
	title={name + ' | PCMT'}
	bodyClass="bg-shade-400 font-sans m-0 min-h-screen grid w-full grid-rows-[auto_1fr_auto]"
	mainClass="mx-auto w-full max-w-315 root bg-shade-300 min-w-0"
>
	<div class="h-full">
		<EventPage event={Astro.props} />
	</div>
</Layout>
