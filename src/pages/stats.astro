---
import StatsPage from '../components/stats/StatsPage';
import Layout from '../layouts/Layout.astro';
---

<Layout
	activePage="Stats"
	desc="the only important page on this website"
	title="Stats | PCMT"
	bodyClass="bg-vlr-gray-400 dark:bg-vlr-gray-900 font-sans m-0 h-dvh grid w-full grid-rows-[auto_minmax(0,1fr)_auto]"
	mainClass="mx-auto w-full max-w-315 root dark:bg-vlr-gray-800 min-w-0 min-h-0"
>
	<div class="h-full">
		<StatsPage client:load />
	</div>
</Layout>
